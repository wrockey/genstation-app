<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>GenStationDemoStorageEnabled</key>
    <string>$(GENSTATION_DEMO_STORAGE_ENABLED)</string>
    <!-- Network: allow http for local ComfyUI server -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- Local network discovery (ComfyUI on same Wi-Fi) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>GenStation needs to discover and connect to your local ComfyUI server on your Wi-Fi network.</string>

    <!-- Photos library -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>GenStation would like to save your generated images to the Photos library.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>GenStation needs access to your photo library to let you select images as input for AI generation.</string>

    <!-- Storyboard-based launch screen (required for iPad multitasking validation) -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- Export compliance: app uses only standard HTTPS (exempt) -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

</dict>
</plist>
